# Copy to .env (never commit .env)

# --- App ---
CREW_ENV=dev
API_BASE_URL=http://localhost:8000
DESKTOP_DEEP_LINK=crew://auth
JWT_SECRET=change-me-to-64-random-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Database / Redis / storage ---
DATABASE_URL=postgresql+asyncpg://crew:crew@localhost:5432/crew
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=crew-library
S3_ACCESS_KEY=crew
S3_SECRET_KEY=crewcrewcrew

# --- AI ---
# LLM_PROVIDER=fake runs the app with a scripted model and no API key (dev only).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CREW_MODEL=claude-opus-5-5
CREW_SMALL_MODEL=claude-haiku-5-5
CREW_MAX_STEPS=40
CREW_DAILY_TOKEN_BUDGET=2000000

# --- Web search (pick one provider) ---
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# --- Auth providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=Crew <no-reply@example.com>
SMTP_URL=            # empty in dev: magic links are printed to the API log

# --- Cloud computer ---
COMPUTER_PROVIDER=docker      # docker | e2b
COMPUTER_IMAGE=crew-computer:dev
COMPUTER_IDLE_MINUTES=10
E2B_API_KEY=

# --- Connectors ---
COMPOSIO_API_KEY=

# --- Vault ---
VAULT_MASTER_KEY=             # dev only: 32 random bytes, base64
VAULT_KMS_KEY_ID=             # prod: AWS KMS key id (when set, used instead of the master key)

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
