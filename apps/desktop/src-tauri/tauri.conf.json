{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crew",
  "version": "0.1.0",
  "identifier": "app.crew.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crew",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.crew.local wss://api.crew.local http://localhost:8000 ws://localhost:8000",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "frame-src": "blob:"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["crew"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
